# Safe variable reference. Node does not load this file automatically.
# Export values in your shell or set them in the hosting provider's environment UI.
NODE_ENV=development
PORT=3000

# Local compose.yaml publishes Redis only on 127.0.0.1:6380.
# In production, prefer REDIS_URL from your hosting provider's secret settings.
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_URL=

# Exact browser origins. Local Vite development uses its same-origin proxy.
CORS_ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=0

# Public anonymous-demo protections.
API_RATE_LIMIT_PER_MINUTE=120
WEBHOOK_SUBMISSION_RATE_LIMIT_PER_MINUTE=10
DEMO_SUBMISSION_RATE_LIMIT_PER_MINUTE=20
MAX_PENDING_WEBHOOK_JOBS=500
MAX_PENDING_DEMO_JOBS=100
WEBHOOK_WORKER_CONCURRENCY=3
DEMO_WORKER_CONCURRENCY=2

# In production, set both values in the hosting provider's secret/config UI.
# The URL must be a bare origin and its exact origin must appear in the allowlist.
HOOKFLOW_RECEIVER_BASE_URL=
HOOKFLOW_RECEIVER_ALLOWED_ORIGINS=
# Production only: use the same random value for API and worker; store it as a secret.
HOOKFLOW_RECEIVER_TOKEN=
